        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a512" ANNOTATION_REF="a456">
                <ANNOTATION_VALUE>e in tutto ciò mentre faccio per accarezzarla, si avvicinò un altro cane e iniziarono a litigare</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a714" ANNOTATION_REF="a713">
                <ANNOTATION_VALUE>cani</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a513" ANNOTATION_REF="a457">
                <ANNOTATION_VALUE>in quel loro momento xxx, ero lì presente durante la lotta tra i cani</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a514" ANNOTATION_REF="a458">
                <ANNOTATION_VALUE>io credo che un cane si sia sbagliato abbia confuso la mia gamba con quella dell'altro cane</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a515" ANNOTATION_REF="a459">
                <ANNOTATION_VALUE>e morse me al posto del cane</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a516" ANNOTATION_REF="a460">
                <ANNOTATION_VALUE>anche in questo momento piansi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a517" ANNOTATION_REF="a461">
                <ANNOTATION_VALUE>perché i miei amici iniziarono a ridere di me</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a518" ANNOTATION_REF="a462">
                <ANNOTATION_VALUE>e quindi io, loro ridevano, meglio non piangere</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a519" ANNOTATION_REF="a463">
                <ANNOTATION_VALUE>arrivai a casa mia e misi la mano poiché stava sanguinando e cominciai a piangere</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a520" ANNOTATION_REF="a464">
                <ANNOTATION_VALUE>e mia mamma stava lavorando</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a521" ANNOTATION_REF="a465">
                <ANNOTATION_VALUE>una mia zia ha dovuto lavarmi la ferita e tutt, aspettare che torni mia mamma</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a522" ANNOTATION_REF="a466">
                <ANNOTATION_VALUE>mi portarono all'ospedale, dovettero bendarmi il ginocchio</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a523" ANNOTATION_REF="a467">
                <ANNOTATION_VALUE>anche il cane stava con le sue vaccinazioni, quindi non</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a525" ANNOTATION_REF="a469">
                <ANNOTATION_VALUE>e sono due morsi di cane che</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a526" ANNOTATION_REF="a476">
                <ANNOTATION_VALUE>grazie</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a527" ANNOTATION_REF="a480">
                <ANNOTATION_VALUE>lei è stata mai in america latina?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a649" ANNOTATION_REF="a602">
                <ANNOTATION_VALUE>a parte che ci vuole tanta responsabilità per imparare una lingua</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a650" ANNOTATION_REF="a610">
                <ANNOTATION_VALUE>perché ci sono le doppie</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a652" ANNOTATION_REF="a612">
                <ANNOTATION_VALUE>mi confondo sempre su questo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a725" ANNOTATION_REF="a724">
                <ANNOTATION_VALUE>nelle doppie</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
