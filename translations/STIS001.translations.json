    "speaker": "PST001_trad",
    "start": "1264.893",
    "end": "1273.547",
    "parent_tu_id": "829",
    "text": "capisco anche i saluti e how are you poco poco"
  },
  {
    "tu_id": "838",
    "speaker": "PST001_trad",
    "start": "1278.787",
    "end": "1283.994",
    "parent_tu_id": "837",
    "text": "come parlate voi sì mi piace"
  },
  {
    "tu_id": "845",
    "speaker": "PST001_trad",
    "start": "1290.893",
    "end": "1302.290",
    "parent_tu_id": "844",
    "text": "una ragazza piccola e ha cominciato a leggere il foglio e aveva un bel suono"
  },
  {
    "tu_id": "852",
    "speaker": "PST001_trad",
    "start": "1304.547",
    "end": "1309.333",
    "parent_tu_id": "851",
    "text": "e io dico a mio marito che parleremo così"
  },
  {
    "tu_id": "857",
    "speaker": "PST001_trad",
    "start": "1312.533",
    "end": "1322.360",
    "parent_tu_id": "856",
    "text": "si sentono molte differenze fra come parliamo noi e voi"
  },
  {
    "tu_id": "869",
    "speaker": "PST001_trad",
    "start": "1335.307",
    "end": "1340.663",
    "parent_tu_id": "868",
    "text": "sì però impareremo piano piano"
  },
  {
    "tu_id": "886",
    "speaker": "PST001_trad",
    "start": "1389.000",
    "end": "1394.787",
    "parent_tu_id": "885",
    "text": "c'era un'infermiera dell'ecuador un'altra venezuelana"
  },
  {
    "tu_id": "890",
    "speaker": "PST001_trad",
    "start": "1395.514",
    "end": "1399.373",
    "parent_tu_id": "889",
    "text": "una peruviana e anche una tecnica"
  },
  {
    "tu_id": "894",
    "speaker": "PST001_trad",
    "start": "1400.347",
    "end": "1402.293",
    "parent_tu_id": "893",
    "text": "sì abbastanza"
  },
  {
    "tu_id": "904",
    "speaker": "PST001_trad",
    "start": "1411.770",
    "end": "1417.700",
    "parent_tu_id": "903",
    "text": "il dottore le spiegava e lei lo ripeteva diceva a me"
  },
  {
    "tu_id": "907",
    "speaker": "PST001_trad",
    "start": "1418.840",
    "end": "1428.787",
    "parent_tu_id": "906",
    "text": "se no con il cellulare qualsiasi domanda avessi la scrivevo qui nel traduttore"
  },
  {
    "tu_id": "910",
    "speaker": "PST001_trad",
    "start": "1428.950",
    "end": "1436.798",
    "parent_tu_id": "909",
    "text": "pronunciarlo dirlo o se no dicevo dottore"
  },
  {
    "tu_id": "915",
    "speaker": "PST001_trad",
    "start": "1436.798",
    "end": "1440.493",
    "parent_tu_id": "914",
    "text": "e così comunicavo"
  },
  {
    "tu_id": "921",
    "speaker": "PST001_trad",
    "start": "1454.320",
    "end": "1458.333",
    "parent_tu_id": "920",
    "text": "per il resto non molto"
  },
  {
    "tu_id": "930",
    "speaker": "PST001_trad",
    "start": "1477.040",
    "end": "1480.653",
    "parent_tu_id": "929",
    "text": "in italiano con i compagni"
  },
  {
    "tu_id": "936",
    "speaker": "PST001_trad",
    "start": "1484.547",
    "end": "1487.811",
    "parent_tu_id": "935",
    "text": "ci sono anche delle peruviane e dei peruviani"
  },
  {
    "tu_id": "939",
    "speaker": "PST001_trad",
    "start": "1487.973",
    "end": "1496.858",
    "parent_tu_id": "938",
    "text": "e con loro un po' così però italiano con persone di altri paesi che stanno studiando lì sì"
  },
  {
    "tu_id": "953",
    "speaker": "PST001_trad",
    "start": "1518.500",
    "end": "1519.453",
    "parent_tu_id": "952",
    "text": "neanche la erre"
  },
  {
    "tu_id": "956",
    "speaker": "PST001_trad",
    "start": "1520.040",
    "end": "1521.556",
    "parent_tu_id": "955",
    "text": "neanche la erre"
  },
  {
    "tu_id": "959",
    "speaker": "PST002_trad",
    "start": "1522.213",
    "end": "1523.027",
    "parent_tu_id": "958",
    "text": "gli africani"
  },
  {
    "tu_id": "962",
    "speaker": "PST001_trad",
    "start": "1524.907",
    "end": "1527.080",
    "parent_tu_id": "961",
    "text": "anche gli africani"
  },
  {
    "tu_id": "964",
    "speaker": "PST002_trad",
    "start": "1525.733",
    "end": "1527.093",
    "parent_tu_id": "963",
    "text": "anche gli africani"
  },
  {
    "tu_id": "966",
    "speaker": "PST001_trad",
    "start": "1527.133",
    "end": "1527.957",
    "parent_tu_id": "965",
    "text": "anche"
  },
  {
    "tu_id": "968",
    "speaker": "PST001_trad",
    "start": "1528.667",
    "end": "1532.800",
    "parent_tu_id": "967",
    "text": "però sì riusciamo a comunicare"
  },
  {
    "tu_id": "971",
    "speaker": "PST001_trad",
    "start": "1533.960",
    "end": "1540.040",
    "parent_tu_id": "970",
    "text": "la lingua è difficile ma proviamo a comunicare no?"
  },
  {
    "tu_id": "982",
    "speaker": "PST001_trad",
    "start": "1557.360",
    "end": "1560.290",
    "parent_tu_id": "981",
    "text": "sì anche film"
  },
  {
    "tu_id": "984",
    "speaker": "PST001_trad",
    "start": "1560.520",
    "end": "1563.280",
    "parent_tu_id": "983",
    "text": "che film abbiamo visto questa volta?"
  },
  {
    "tu_id": "986",
    "speaker": "PST002_trad",
    "start": "1561.387",
    "end": "1562.320",
    "parent_tu_id": "985",
    "text": "film?"
  },
  {
    "tu_id": "994",
    "speaker": "PST001_trad",
    "start": "1575.060",
    "end": "1578.120",
    "parent_tu_id": "993",
    "text": "ci sono frasi che riusciamo"
  },
  {
    "tu_id": "998",
    "speaker": "PST001_trad",
    "start": "1582.844",
    "end": "1587.560",
    "parent_tu_id": "997",
    "text": "perché non andavamo ancora a scuola"
  },
  {
    "tu_id": "1000",
    "speaker": "PST001_trad",
    "start": "1587.947",
    "end": "1595.919",
    "parent_tu_id": "999",
    "text": "quindi con i video i film su youtube imparavamo l'italiano"
  },
  {
    "tu_id": "1005",
    "speaker": "PST001_trad",
    "start": "1596.893",
    "end": "1601.730",
    "parent_tu_id": "1004",
    "text": "dopo un mio amico mi ha detto di venire qui"
  },
  {
    "tu_id": "1007",
    "speaker": "PST001_trad",
    "start": "1602.250",
    "end": "1604.290",
    "parent_tu_id": "1006",
    "text": "e da allora un po' di più"
  },
  {
    "tu_id": "1010",
    "speaker": "PST001_trad",
    "start": "1605.773",
    "end": "1608.053",
    "parent_tu_id": "1009",
    "text": "un po' di più per imparare"
  },
  {
    "tu_id": "1016",
    "speaker": "PST001_trad",
    "start": "1619.704",
    "end": "1626.980",
    "parent_tu_id": "1015",
    "text": "esce come fa? mi piace una ragazza questa canzone sì"
  },
  {
    "tu_id": "1021",
    "speaker": "PST001_trad",
    "start": "1627.453",
    "end": "1630.200",
    "parent_tu_id": "1020",
    "text": "questa esce sempre"
  },
  {
    "tu_id": "1025",
    "speaker": "PST001_trad",
    "start": "1631.599",
    "end": "1639.617",
    "parent_tu_id": "1024",
    "text": "altre canzoni non me le ricordo però questa canzone mi piace una ragazza di più"
  },
  {
    "tu_id": "1035",
    "speaker": "PST001_trad",
    "start": "1648.612",
    "end": "1652.780",
    "parent_tu_id": "1034",
    "text": "laura pausini tiziano ferro sì anche"
  },
  {
    "tu_id": "1048",
    "speaker": "PST001_trad",
    "start": "1674.360",
    "end": "1678.151",
    "parent_tu_id": "1047",
    "text": "eh lo svegliamo come si dice?"
  },
  {
    "tu_id": "1051",
    "speaker": "PST001_trad",
    "start": "1678.800",
    "end": "1681.200",
    "parent_tu_id": "1049",
    "text": "svegliamo mio figlio"
  },
  {
    "tu_id": "1069",
    "speaker": "PST001_trad",
    "start": "1705.773",
    "end": "1711.920",
    "parent_tu_id": "1068",
    "text": "è un bambino tranquillo quindi capisce"
  },
  {
    "tu_id": "1072",
    "speaker": "PST002_trad",
    "start": "1713.400",
    "end": "1718.813",
    "parent_tu_id": "1071",
    "text": "allo stesso modo quando usciamo"
  },
  {
    "tu_id": "1085",
    "speaker": "PST002_trad",
    "start": "1728.307",
    "end": "1729.667",
    "parent_tu_id": "1084",
    "text": "diventa viola"
  },
  {
    "tu_id": "1089",
    "speaker": "PST001_trad",
    "start": "1730.187",
    "end": "1732.580",
    "parent_tu_id": "1087",
    "text": "le labbra le dita"
  },
  {
    "tu_id": "1094",
    "speaker": "PST002_trad",
    "start": "1734.107",
    "end": "1735.773",
    "parent_tu_id": "1093",
    "text": "quindi devo"
  },
  {
    "tu_id": "1096",
    "speaker": "PST001_trad",
    "start": "1735.773",
    "end": "1736.987",
    "parent_tu_id": "1095",
    "text": "prenderlo in braccio"
  },
  {
    "tu_id": "1098",
    "speaker": "PST001_trad",
    "start": "1736.987",
    "end": "1738.613",
    "parent_tu_id": "1097",
    "text": "lo prendo in braccio"
  },
  {
    "tu_id": "1103",
    "speaker": "PST002_trad",
    "start": "1741.227",
    "end": "1743.560",
    "parent_tu_id": "1102",
    "text": "mi stanco un po'"
  },
  {
    "tu_id": "1105",
    "speaker": "PST001_trad",
    "start": "1744.147",
    "end": "1747.533",
    "parent_tu_id": "1104",
    "text": "alla fine si stanca"
  },
  {
    "tu_id": "1108",
    "speaker": "PST001_trad",
    "start": "1747.533",
    "end": "1753.213",
    "parent_tu_id": "1107",
    "text": "il giorno un po' come si dice stanco"
  },
  {
    "tu_id": "1121",
    "speaker": "PST001_trad",
    "start": "1780.267",
    "end": "1782.760",
    "parent_tu_id": "1120",
    "text": "perché non fa molto freddo"
  },
  {
    "tu_id": "1124",
    "speaker": "PST001_trad",
    "start": "1783.200",
    "end": "1786.770",
    "parent_tu_id": "1122",
    "text": "quando faceva molto freddo non potevamo"
  },
  {
    "tu_id": "1132",
    "speaker": "PST001_trad",
    "start": "1789.987",
    "end": "1794.667",
    "parent_tu_id": "1130",
    "text": "ah sì pioggia pioveva molto"
  },
  {
    "tu_id": "1134",
    "speaker": "PST001_trad",
    "start": "1795.107",
    "end": "1799.210",
    "parent_tu_id": "1133",
    "text": "sopratutto per mio figlio no? per mio figlio per questo che"
  },
  {
    "tu_id": "1136",
    "speaker": "PST001_trad",
    "start": "1799.460",
    "end": "1805.150",
    "parent_tu_id": "1135",
    "text": "abbiamo rinunciato a uscire no?"
  },
  {
    "tu_id": "1139",
    "speaker": "PST001_trad",
    "start": "1805.893",
    "end": "1815.293",
    "parent_tu_id": "1138",
    "text": "per stare attenti alla salute di mio figlio perché non prendesse la tosse"
  },
  {
    "tu_id": "1142",
    "speaker": "PST001_trad",
    "start": "1816.080",
    "end": "1824.138",
    "parent_tu_id": "1141",
    "text": "e l'influenza no? neanche il dottore sapeva ha detto di tenerlo a casa"
  },
  {
    "tu_id": "1144",
    "speaker": "PST001_trad",
    "start": "1824.773",
    "end": "1825.453",
    "parent_tu_id": "1143",
    "text": "e basta"
  },
  {
    "tu_id": "1146",
    "speaker": "PST001_trad",
    "start": "1826.133",
    "end": "1835.347",
    "parent_tu_id": "1145",
    "text": "allora il clima un po' di sole l'aria fresca non più tanto fredda"
  },
  {
    "tu_id": "1149",
    "speaker": "PST001_trad",
    "start": "1836.688",
    "end": "1840.696",
    "parent_tu_id": "1148",
    "text": "usciamo sì sì"
  },
  {
    "tu_id": "1165",
    "speaker": "PST002_trad",
    "start": "1875.867",
    "end": "1877.173",
    "parent_tu_id": "1164",
    "text": "in un'altra città"
  },
  {
    "tu_id": "1167",
    "speaker": "PST001_trad",
    "start": "1876.440",
    "end": "1879.400",
    "parent_tu_id": "1166",
    "text": "lontano in un'altra città"
  },
  {
    "tu_id": "1170",
    "speaker": "PST002_trad",
    "start": "1878.627",
    "end": "1880.360",
    "parent_tu_id": "1169",
    "text": "in un'altra città"
  },
  {
    "tu_id": "1172",
    "speaker": "PST002_trad",
    "start": "1881.733",
    "end": "1887.133",
    "parent_tu_id": "1171",
    "text": "tornavo a casa ogni ventotto giorni"
  },
  {
    "tu_id": "1193",
    "speaker": "PST002_trad",
    "start": "1907.324",
    "end": "1914.877",
    "parent_tu_id": "1192",
    "text": "otto anni con questo lavoro"
  },
  {
    "tu_id": "1197",
    "speaker": "PST002_trad",
    "start": "1917.240",
    "end": "1919.493",
    "parent_tu_id": "1196",
    "text": "quello di prima?"
  },
  {
    "tu_id": "1201",
    "speaker": "PST002_trad",
    "start": "1922.187",
    "end": "1927.627",
    "parent_tu_id": "1200",
    "text": "lavoravo in un'azienda di vestiti"
  },
  {
    "tu_id": "1205",
    "speaker": "PST001_trad",
    "start": "1929.813",
    "end": "1932.728",
    "parent_tu_id": "1204",
    "text": "come zara come acca e emme sì"
  },
  {
    "tu_id": "1216",
    "speaker": "PST001_trad",
    "start": "1939.200",
    "end": "1941.600",
    "parent_tu_id": "1214",
    "text": "qui non c'è"
  },
  {
    "tu_id": "1225",
    "speaker": "PST002_trad",
    "start": "1950.500",
    "end": "1954.000",
    "parent_tu_id": "1224",
    "text": "da quando sono arrivato qui un po' di"
  },
  {
    "tu_id": "1230",
    "speaker": "PST002_trad",
    "start": "1960.933",
    "end": "1964.140",
    "parent_tu_id": "1229",
    "text": "senza il permesso non posso lavorare"
  },
  {
    "tu_id": "1242",
    "speaker": "PST001_trad",
    "start": "1975.147",
    "end": "1981.000",
    "parent_tu_id": "1241",
    "text": "abbiamo già chiesto l'articolo trentuno?"
  },
  {
    "tu_id": "1247",
    "speaker": "PST001_trad",
    "start": "1984.960",
    "end": "1987.533",
    "parent_tu_id": "1246",
    "text": "ci hanno dato una risposta positiva"
  },
  {
    "tu_id": "1249",
    "speaker": "PST001_trad",
    "start": "1988.693",
    "end": "1996.068",
    "parent_tu_id": "1248",
    "text": "e ci consegnano il permesso di soggiorno fra un mese"
  },
  {
    "tu_id": "1252",
    "speaker": "PST001_trad",
    "start": "1997.347",
    "end": "2000.280",
    "parent_tu_id": "1251",
    "text": "e saremo un po' più tranquilli"
  },
  {
    "tu_id": "1259",
    "speaker": "PST001_trad",
    "start": "2006.600",
    "end": "2011.773",
    "parent_tu_id": "1258",
    "text": "qui è difficile anche trovare casa"
  },
  {
    "tu_id": "1266",
    "speaker": "PST001_trad",
    "start": "2015.547",
    "end": "2019.507",
    "parent_tu_id": "1265",
    "text": "devi avere un lavoro permanente no?"
  },
  {
    "tu_id": "1269",
    "speaker": "PST001_trad",
    "start": "2020.213",
    "end": "2026.480",
    "parent_tu_id": "1268",
    "text": "molto difficile invece in perù gli affitti"
  },
  {
    "tu_id": "1272",
    "speaker": "PST001_trad",
    "start": "2027.467",
    "end": "2031.960",
    "parent_tu_id": "1271",
    "text": "sono veloci paghi due mesi"
  },
  {
    "tu_id": "1274",
    "speaker": "PST002_trad",
    "start": "2028.387",
    "end": "2029.132",
    "parent_tu_id": "1273",
    "text": "a chiunque"
  },
  {
    "tu_id": "1277",
    "speaker": "PST001_trad",
    "start": "2033.730",
    "end": "2035.747",
    "parent_tu_id": "1276",
    "text": "del prezzo dell'affitto"
  },
  {
    "tu_id": "1280",
    "speaker": "PST001_trad",
    "start": "2037.640",
    "end": "2041.988",
    "parent_tu_id": "1279",
    "text": "si trova casa qui no"
  },
  {
    "tu_id": "1297",
    "speaker": "PST001_trad",
    "start": "2071.213",
    "end": "2075.307",
    "parent_tu_id": "1296",
    "text": "da allora lei aiuta molto"
  },
  {
    "tu_id": "1301",
    "speaker": "PST001_trad",
    "start": "2076.947",
    "end": "2081.853",
    "parent_tu_id": "1300",
    "text": "si interessa di mio figlio come sta va tutto bene"
  },
  {
    "tu_id": "1315",
    "speaker": "PST001_trad",
    "start": "2097.760",
    "end": "2100.840",
    "parent_tu_id": "1314",
    "text": "non è lontano è vicino"
  },
  {
    "tu_id": "1330",
    "speaker": "PST001_trad",
    "start": "2115.749",
    "end": "2123.035",
    "parent_tu_id": "1329",
    "text": "tramite mia suocera abbiamo conosciuto la signora paola si chiama paola la signora"
  },
  {
    "tu_id": "1340",
    "speaker": "PST001_trad",
    "start": "2132.438",
    "end": "2135.604",
    "parent_tu_id": "1339",
    "text": "infinitamente grati sì"
  },
  {
    "tu_id": "1344",
    "speaker": "PST001_trad",
    "start": "2136.894",
    "end": "2139.574",
    "parent_tu_id": "1343",
    "text": "non tutte le persone ti aiutano no?"
  },
  {
    "tu_id": "1351",
    "speaker": "PST001_trad",
    "start": "2151.402",
    "end": "2157.920",
    "parent_tu_id": "1350",
    "text": "lui prima non voleva venire"
  },
  {
    "tu_id": "1354",
    "speaker": "PST002_trad",
    "start": "2157.920",
    "end": "2158.560",
    "parent_tu_id": "1353",
    "text": "non volevo"
  },
  {
    "tu_id": "1362",
    "speaker": "PST001_trad",
    "start": "2167.240",
    "end": "2171.894",
    "parent_tu_id": "1361",
    "text": "è più parlare dialogare"
  },
  {
    "tu_id": "1364",
    "speaker": "PST001_trad",
    "start": "2172.734",
    "end": "2179.560",
    "parent_tu_id": "1363",
    "text": "lui un po' non capisce allora era per questo no?"
  },
  {
    "tu_id": "1367",
    "speaker": "PST002_trad",
    "start": "2185.119",
    "end": "2187.680",
    "parent_tu_id": "1366",
    "text": "più per il fatto di mio figlio"
  },
  {
    "tu_id": "1369",
    "speaker": "PST002_trad",
    "start": "2187.920",
    "end": "2190.307",
    "parent_tu_id": "1368",
    "text": "cioè lasciarlo da solo"
  },
  {
    "tu_id": "1373",
    "speaker": "PST002_trad",
    "start": "2191.734",
    "end": "2196.081",
    "parent_tu_id": "1372",
    "text": "dato che non sta bene gli può succedere qualsiasi cosa non per altro"
  },
  {
    "tu_id": "1375",
    "speaker": "PST002_trad",
    "start": "2196.799",
    "end": "2197.647",
    "parent_tu_id": "1374",
    "text": "però dopo"
  },
  {
    "tu_id": "1378",
    "speaker": "PST002_trad",
    "start": "2200.622",
    "end": "2201.379",
    "parent_tu_id": "1377",
    "text": "non c'è stato problema"
  },
  {
    "tu_id": "1396",
    "speaker": "PST001_trad",
    "start": "2237.396",
    "end": "2244.680",
    "parent_tu_id": "1395",
    "text": "però anche sua sorella è in italia"
  },
  {
    "tu_id": "1403",
    "speaker": "PST001_trad",
    "start": "2249.120",
    "end": "2254.187",
    "parent_tu_id": "1402",
    "text": "però amici peruviani con cui no"
  },
  {
    "tu_id": "1447",
    "speaker": "PST002_trad",
    "start": "2323.814",
    "end": "2324.743",
    "parent_tu_id": "1446",
    "text": "dopo ho smesso"
  },
  {
    "tu_id": "1450",
    "speaker": "PST002_trad",
    "start": "2325.734",
    "end": "2330.414",
    "parent_tu_id": "1449",
    "text": "e poi bartender"
  },
  {
    "tu_id": "1469",
    "speaker": "PST002_trad",
    "start": "2342.374",
    "end": "2344.720",
    "parent_tu_id": "1468",
    "text": "ma non ho finito neanche quello"
  },
  {
    "tu_id": "1481",
    "speaker": "PST002_trad",
    "start": "2371.520",
    "end": "2372.734",
    "parent_tu_id": "1480",
    "text": "social network?"
  },
  {
    "tu_id": "1497",
    "speaker": "PST001_trad",
    "start": "2389.200",
    "end": "2392.160",
    "parent_tu_id": "1496",
    "text": "però dovrebbe essere in italiano"
  },
  {
    "tu_id": "1503",
    "speaker": "PST001_trad",
    "start": "2396.774",
    "end": "2402.014",
    "parent_tu_id": "1502",
    "text": "in ogni caso io la tastiera l'ho messa in italiano"
  },
  {
    "tu_id": "1514",
    "speaker": "PST001_trad",
    "start": "2414.800",
    "end": "2416.667",
    "parent_tu_id": "1513",
    "text": "qui non c'è la eñe"
  },
  {
    "tu_id": "1516",
    "speaker": "PST001_trad",
    "start": "2417.266",
    "end": "2420.795",
    "parent_tu_id": "1515",
    "text": "la enne con sì qui non c'è la eñe"
  },
  {
    "tu_id": "1519",
    "speaker": "PST001_trad",
    "start": "2420.795",
    "end": "2424.574",
    "parent_tu_id": "1518",
    "text": "alcune parole lettere no? lettere"
  },
  {
    "tu_id": "1530",
    "speaker": "PST001_trad",
    "start": "2436.040",
    "end": "2441.053",
    "parent_tu_id": "1529",
    "text": "dato che mio figlio che è già un po' più grande andiamo"
  },
  {
    "tu_id": "1543",
    "speaker": "PST001_trad",
    "start": "2465.974",
    "end": "2468.005",
    "parent_tu_id": "1541",
    "text": "si non si abitua"
  },
  {
    "tu_id": "1551",
    "speaker": "PST001_trad",
    "start": "2485.454",
    "end": "2491.200",
    "parent_tu_id": "1550",
    "text": "tranquillo però ci sono posti che non gli piacciono allora"
  },
  {
    "tu_id": "1560",
    "speaker": "PST002_trad",
    "start": "2501.360",
    "end": "2510.111",
    "parent_tu_id": "1559",
    "text": "un poco difficile rimanere in un posto con amici con mio figlio"
  },
  {
    "tu_id": "1565",
    "speaker": "PST002_trad",
    "start": "2511.094",
    "end": "2512.800",
    "parent_tu_id": "1564",
    "text": "non riesce a stare solo molto tempo"
  },
  {
    "tu_id": "1579",
    "speaker": "PST002_trad",
    "start": "2539.000",
    "end": "2540.720",
    "parent_tu_id": "1578",
    "text": "no qui no ancora no"
  },
  {
    "tu_id": "1581",
    "speaker": "PST001_trad",
    "start": "2540.720",
    "end": "2542.320",
    "parent_tu_id": "1580",
    "text": "ancora no"
  },
  {
    "tu_id": "1585",
    "speaker": "PST002_trad",
    "start": "2542.867",
    "end": "2551.467",
    "parent_tu_id": "1584",
    "text": "cuando inizio a lavorare credo che con amici un sabato o una domenica"
  },
  {
    "tu_id": "1589",
    "speaker": "PST002_trad",
    "start": "2553.107",
    "end": "2554.267",
    "parent_tu_id": "1588",
    "text": "adesso non c'è tempo"
  },
  {
    "tu_id": "1595",
    "speaker": "PST002_trad",
    "start": "2563.467",
    "end": "2565.187",
    "parent_tu_id": "1594",
    "text": "sì gli parlerò"
  },
  {
    "tu_id": "1630",
    "speaker": "PST002_trad",
    "start": "2613.947",
    "end": "2618.640",
    "parent_tu_id": "1629",
    "text": "mio figlio cartoni animati paperi"
  },
  {
    "tu_id": "1653",
    "speaker": "PST001_trad",
    "start": "2647.014",
    "end": "2649.187",
    "parent_tu_id": "1652",
    "text": "lui vuole andare a scuola"
  },
  {
    "tu_id": "1656",
    "speaker": "PST001_trad",
    "start": "2651.000",
    "end": "2652.080",
    "parent_tu_id": "1655",
    "text": "vuole andarci"
  },
  {
    "tu_id": "1659",
    "speaker": "PST001_trad",
    "start": "2653.347",
    "end": "2655.360",
    "parent_tu_id": "1658",
    "text": "da quando siamo arrivati qui"
  },
  {
    "tu_id": "1665",
    "speaker": "PST002_trad",
    "start": "2666.000",
    "end": "2671.294",
    "parent_tu_id": "1664",
    "text": "chiedevano i documenti che non abbiamo"
  },
  {
    "tu_id": "1671",
    "speaker": "PST001_trad",
    "start": "2671.294",
    "end": "2679.520",
    "parent_tu_id": "1669",
    "text": "dove a scuola? no a scuola solamente i vaccini"
  },
  {
    "tu_id": "1676",
    "speaker": "PST001_trad",
    "start": "2679.520",
    "end": "2689.120",
    "parent_tu_id": "1675",
    "text": "il certificato dei vaccini il codice fiscale e il passaporto ma non c'era posto"
  },
  {
    "tu_id": "1679",
    "speaker": "PST002_trad",
    "start": "2685.747",
    "end": "2686.734",
    "parent_tu_id": "1678",
    "text": "non c'era posto"
  },
  {
    "tu_id": "1682",
    "speaker": "PST001_trad",
    "start": "2689.680",
    "end": "2693.880",
    "parent_tu_id": "1681",
    "text": "sono andata in varie scuole cercando"
  },
  {
    "tu_id": "1685",
    "speaker": "PST001_trad",
    "start": "2695.200",
    "end": "2703.499",
    "parent_tu_id": "1684",
    "text": "però ne ho trovata una vicino"
  },
  {
    "tu_id": "1689",
    "speaker": "PST001_trad",
    "start": "2704.000",
    "end": "2712.678",
    "parent_tu_id": "1688",
    "text": "lì il maestro giorgio si chiama è informato su mio figlio"
  },
  {
    "tu_id": "1698",
    "speaker": "PST001_trad",
    "start": "2722.347",
    "end": "2729.838",
    "parent_tu_id": "1697",
    "text": "non può andare finché non è più stabile il bambino"
  },
  {
    "tu_id": "1708",
    "speaker": "PST001_trad",
    "start": "2746.080",
    "end": "2755.911",
    "parent_tu_id": "1707",
    "text": "allora in perù è diversa la scuola in perù inizia a marzo la scuola"
  },
  {
    "tu_id": "1717",
    "speaker": "PST001_trad",
    "start": "2757.667",
    "end": "2765.410",
    "parent_tu_id": "1715",
    "text": "lunedì è iniziata la scuola in perù in dicembre"
  },
  {
    "tu_id": "1740",
    "speaker": "PST001_trad",
    "start": "2784.224",
    "end": "2791.800",
    "parent_tu_id": "1739",
    "text": "ma anche il clima è diverso sì in marzo"
  },
  {
    "tu_id": "1747",
    "speaker": "PST002_trad",
    "start": "2792.947",
    "end": "2793.454",
    "parent_tu_id": "1746",
    "text": "autunno"
  },
  {
    "tu_id": "1749",
    "speaker": "PST001_trad",
    "start": "2794.387",
    "end": "2796.027",
    "parent_tu_id": "1748",
    "text": "è estate ancora"
  },
  {
    "tu_id": "1751",
    "speaker": "PST002_trad",
    "start": "2795.000",
    "end": "2796.027",
    "parent_tu_id": "1750",
    "text": "l'estate finisce"
  },
  {
    "tu_id": "1753",
    "speaker": "PST001_trad",
    "start": "2796.616",
    "end": "2803.640",
    "parent_tu_id": "1752",
    "text": "aprile marzo inizia l'autonno"
  },
  {
    "tu_id": "1759",
    "speaker": "PST001_trad",
    "start": "2803.960",
    "end": "2814.040",
    "parent_tu_id": "1758",
    "text": "l'inverno inizia a luglio giugno luglio agosto l'inverno"
  },
  {
    "tu_id": "1775",
    "speaker": "PST001_trad",
    "start": "2833.200",
    "end": "2835.867",
    "parent_tu_id": "1774",
    "text": "un mese prima della fine della scuola"
  },
  {
    "tu_id": "1782",
    "speaker": "PST001_trad",
    "start": "2847.480",
    "end": "2852.547",
    "parent_tu_id": "1781",
    "text": "cercando la scuola"
  },
  {
    "tu_id": "1786",
    "speaker": "PST001_trad",
    "start": "2852.547",
    "end": "2863.694",
    "parent_tu_id": "1785",
    "text": "proprio quando il dottore mi chiama per l'intervento il maestro giorgio mi chiama dalla scuola dicendo che c'è vacanza"
  },
  {
    "tu_id": "1790",
    "speaker": "PST002_trad",
    "start": "2863.840",
    "end": "2866.440",
    "parent_tu_id": "1788",
    "text": "ti ha chiamato"
  },
  {
    "tu_id": "1792",
    "speaker": "PST001_trad",
    "start": "2864.402",
    "end": "2869.067",
    "parent_tu_id": "1791",
    "text": "lo stesso giorno"
  },
  {
    "tu_id": "1794",
    "speaker": "PST001_trad",
    "start": "2869.067",
    "end": "2882.187",
    "parent_tu_id": "1793",
    "text": "preferisco l'intervento no? quindi abbiamo detto al maestro giorgio che alonso non poteva andare"
  }
]